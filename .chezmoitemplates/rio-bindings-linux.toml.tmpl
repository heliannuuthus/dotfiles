  # Linux 沿用既有 Ctrl/Shift/Alt 键位，避开桌面常占用的 Super 组合键。
  # 原生搜索栏使用 Ctrl+U、Ctrl+W、Backspace；Option/Alt 方向键仅供 shell 编辑。
  { key = "left", with = "control", esc = "\u001bb" },
  { key = "right", with = "control", esc = "\u001bf" },
  { key = "left", with = "alt", esc = "\u001bb" },
  { key = "right", with = "alt", esc = "\u001bf" },
  { key = "backspace", with = "control", esc = "\u0017" },
  { key = "backspace", with = "alt", esc = "\u0017" },
  { key = "backspace", with = "control | shift", esc = "\u0015" },

  # 标签页；保留原先 Ctrl+Shift+T 新标签、Alt+数字切换。
  { key = "t", with = "control | shift", action = "CreateTab" },
  { key = "n", with = "control | shift", action = "CreateWindow" },
  { key = "w", with = "control | shift", action = "CloseSplitOrTab" },
  { key = "q", with = "control | shift", action = "CloseTab" },
  { key = "]", with = "control | shift", action = "SelectNextTab" },
  { key = "[", with = "control | shift", action = "SelectPrevTab" },
  { key = "1", with = "alt", action = "SelectTab(0)" },
  { key = "2", with = "alt", action = "SelectTab(1)" },
  { key = "3", with = "alt", action = "SelectTab(2)" },
  { key = "4", with = "alt", action = "SelectTab(3)" },
  { key = "5", with = "alt", action = "SelectTab(4)" },
  { key = "6", with = "alt", action = "SelectTab(5)" },
  { key = "7", with = "alt", action = "SelectTab(6)" },
  { key = "8", with = "alt", action = "SelectTab(7)" },
  { key = "9", with = "alt", action = "SelectTab(8)" },

  # 分屏：明确右/下方向，继承当前目录；焦点只有前/后循环语义。
  { key = "return", with = "control | shift", action = "SplitRight" },
  { key = "d", with = "control | shift", action = "SplitDown" },
  { key = "left", with = "control | alt", action = "SelectPrevSplit" },
  { key = "up", with = "control | alt", action = "SelectPrevSplit" },
  { key = "right", with = "control | alt", action = "SelectNextSplit" },
  { key = "down", with = "control | alt", action = "SelectNextSplit" },
  { key = "left", with = "control | shift", action = "MoveDividerLeft" },
  { key = "right", with = "control | shift", action = "MoveDividerRight" },
  { key = "up", with = "control | shift", action = "MoveDividerUp" },
  { key = "down", with = "control | shift", action = "MoveDividerDown" },

  # 滚动、原生 Vi 历史浏览和提示符跳转。
  { key = "pageup", with = "control | shift", action = "ScrollPageUp" },
  { key = "pagedown", with = "control | shift", action = "ScrollPageDown" },
  { key = "home", with = "control | shift", action = "ScrollToTop" },
  { key = "end", with = "control | shift", action = "ScrollToBottom" },
  { key = "h", with = "control | shift", action = "ToggleViMode" },
  { key = "g", with = "control | shift", mode = "~alt", action = "ScrollToPrevPrompt" },
  { key = "pageup", with = "control | shift | alt", mode = "~alt", action = "ScrollToPrevPrompt" },
  { key = "pagedown", with = "control | shift | alt", mode = "~alt", action = "ScrollToNextPrompt" },
  { key = "/", with = "control | shift", action = "SearchForward" },
  { key = "f", with = "control | shift", action = "SearchForward" },
  { key = "b", with = "control | shift", action = "SearchBackward" },

  # Ctrl+V 交给应用；OMP 图片优先粘贴另提供 Ctrl+Shift+Alt+V 别名。
  { key = "c", with = "control | shift", action = "Copy" },
  { key = "v", with = "control | shift", action = "Paste" },
  { key = "v", with = "control | shift | alt", esc = "\u0016" },

  { key = "=", with = "control | shift", action = "IncreaseFontSize" },
  { key = "=", with = "control", action = "IncreaseFontSize" },
  { key = "-", with = "control", action = "DecreaseFontSize" },
  { key = "0", with = "control", action = "ResetFontSize" },
  { key = "f5", with = "control | shift", action = "OpenConfigEditor" },
  { key = "f11", with = "control | shift", action = "ToggleFullscreen" },
  { key = "escape", with = "control | shift", action = "OpenCommandPalette" },
