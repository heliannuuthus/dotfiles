# Rio 0.5.29 跨平台配置，由 chezmoi 按系统生成。
# 不依赖 tmux；不修改 Rio 源码。
# 配置键以 v0.5.29 tag 为准，官网部分文档描述的是更新的开发版本。
# 不提供自动布局循环、单分屏放大或临时分屏标题。

# 每个分屏统一由 panel.margin 提供 16px 留白，避免外侧叠加。
margin = [0]
copy-on-select = true
confirm-before-quit = false
scrollback-history-limit = 10000
shell-integration = true
line-height = 1.0
force-theme = "dark"

[window]
width = 900
height = 500
mode = "Windowed"
opacity = 1.0
blur = false
{{ if eq .chezmoi.os "darwin" -}}
# 原生标题栏使用终端背景，随 macOS 全屏行为收起。
decorations = "Transparent"
macos-use-unified-titlebar = false
{{ else -}}
decorations = "Enabled"
{{ end -}}

[panel]
# 0.5.29 的 padding 没有推开正文，使用 margin 实现分屏内留白。
# 修改这些布局参数后需新建 Rio 窗口。
margin = [16]
padding = [0]
border-width = 1.0
border-radius = 0.0
row-gap = 0
column-gap = 0

[fonts]
family = "LXGW WenKai Mono"
size = 16
symbol-map = [
  # Rio 的 end 不包含端点，Unicode 范围使用 [start, end)。
  { start = "4E00", end = "A000", font-family = "LXGW WenKai Mono" },
  { start = "3400", end = "4DC0", font-family = "LXGW WenKai Mono" },
  { start = "F900", end = "FB00", font-family = "LXGW WenKai Mono" },
  { start = "3000", end = "3040", font-family = "LXGW WenKai Mono" },
  { start = "FF00", end = "FFF0", font-family = "LXGW WenKai Mono" },
  { start = "2000", end = "2070", font-family = "LXGW WenKai Mono" },
  { start = "1F300", end = "1FB00", font-family = "{{ if eq .chezmoi.os "darwin" }}Apple Color Emoji{{ else }}Noto Color Emoji{{ end }}" },
]

[cursor]
shape = "underline"
blinking = true
blinking-interval = 500

[scroll]
multiplier = 5.0
divider = 1.0

[bell]
audio = false
visual = false
tab-indicator = true

[navigation]
{{ if eq .chezmoi.os "darwin" -}}
# macOS 原生标题/标签栏，随系统全屏行为自动收起。
mode = "NativeTab"
{{ else -}}
# Linux 自绘标签栏：单标签隐藏，不预留空标题区。
mode = "Tab"
hide-if-single = true
{{ end -}}
use-terminal-title = true
current-working-directory = true
use-split = true
# 非当前内容向终端背景色混合 30%，柔和提示焦点，避免黑色块的硬边。
unfocused-split-opacity = 0.7
unfocused-split-fill = "#222221"

[title]
# 跟随当前选中的分屏：程序设置的标题 -> 当前目录 -> 启动程序名。
content = {{ "{{ TITLE || RELATIVE_PATH || PROGRAM }}" | quote }}

[editor]
{{ if eq .chezmoi.os "darwin" -}}
program = "{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/nvim"
{{ else -}}
program = "/usr/bin/nvim"
{{ end -}}
args = []

[colors]
# Material Dark 配色，使用低饱和灰蓝色的输入/选区高亮。
# Rio 0.5.29 将 cursor 同时作为中文预编辑的底色，预编辑文字为终端背景色。
background = "#222221"
foreground = "#e4e4e4"
cursor = "#91a5b6"
vi-cursor = "#91a5b6"
selection-background = "#3b4d5d"
selection-foreground = "#e4e4e4"
black = "#212121"
red = "#b7141e"
green = "#457b23"
yellow = "#f5971d"
blue = "#134eb2"
magenta = "#550087"
cyan = "#0e707c"
white = "#eeeeee"
light-black = "#424242"
light-red = "#e83a3f"
light-green = "#7aba39"
light-yellow = "#fee92e"
light-blue = "#53a4f3"
light-magenta = "#a94dbb"
light-cyan = "#26bad1"
light-white = "#d8d8d8"
bar = "#222221"
tabs = "#888888"
tabs-active = "#e4e4e4"
split = "#7aa2f7"

[bindings]
keys = [
{{ if eq .chezmoi.os "darwin" -}}
{{ template "rio-bindings-macos.toml.tmpl" . -}}
{{ else -}}
{{ template "rio-bindings-linux.toml.tmpl" . -}}
{{ end -}}
]

# URL 提示：macOS 使用 Cmd+Shift+E，Linux 使用 Ctrl+Shift+E；点击使用相同修饰键。
# Rio 0.5.29 的纯文本长 URL 跨软换行时，请用鼠标；键盘提示尚不拼接物理行。
[[hints.rules]]
regex = '(?:https?|ftps?|file|gemini|git|gopher|ircs?|mailto|news|sftp|ssh):[^\s<>"`\\]+'
hyperlinks = true
post-processing = true
persist = false
action = "Open"
mouse = { enabled = true, mods = ["{{ if eq .chezmoi.os "darwin" }}Super{{ else }}Control{{ end }}", "Shift"] }
binding = { key = "e", mods = ["{{ if eq .chezmoi.os "darwin" }}Super{{ else }}Control{{ end }}", "Shift"] }
